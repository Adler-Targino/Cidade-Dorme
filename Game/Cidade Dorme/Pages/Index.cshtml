@page
@{
    ViewData["Title"] = "Cidade Dorme";
}

<div class="min-h-screen flex items-center justify-center bg-base-200 px-4 py-10">
    <main class="w-full max-w-md">
        <section class="card bg-base-100 shadow-2xl border border-base-300">
            <div class="card-body gap-6 p-6 sm:p-8">

                <header class="text-center space-y-3">
                    <div class="avatar placeholder">
                        <div class="bg-primary text-primary-content rounded-full w-20">
                            <span class="text-4xl">🌙</span>
                        </div>
                    </div>

                    <h1 class="text-3xl font-bold tracking-tight">
                        Cidade Dorme
                    </h1>

                    <p class="text-base-content/70">
                        A noite chegou. Em quem você confia?
                    </p>
                </header>

                <div class="divider my-0"></div>

                <form id="lobbyForm" class="space-y-5">
                    <div class="form-control w-full">
                        <label class="label" for="playerName">
                            <span class="label-text font-semibold">Seu nome</span>
                        </label>

                        <input id="playerName"
                               name="playerName"
                               type="text"
                               class="input input-bordered w-full"
                               placeholder="Como devemos chamar você?"
                               maxlength="20"
                               autocomplete="nickname"
                               required />
                    </div>

                    <div class="form-control w-full">
                        <label class="label" for="roomCode">
                            <span class="label-text font-semibold">Código da sala</span>
                        </label>

                        <input id="roomCode"
                               name="roomCode"
                               type="text"
                               class="input input-bordered w-full uppercase"
                               placeholder="Ex.: LUA7K2"
                               maxlength="6"
                               autocomplete="off"
                               aria-describedby="roomHelp" />

                        <label class="label">
                            <span id="roomHelp" class="label-text-alt text-base-content/60">
                                Preencha para entrar em uma sala existente.
                            </span>
                        </label>
                    </div>

                    <div id="formMessage"
                         class="alert alert-error hidden"
                         role="alert">
                        <span id="formMessageText"></span>
                    </div>

                    <div class="space-y-3 pt-1">
                        <button id="joinRoomButton"
                                type="button"
                                class="btn btn-primary w-full">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="20" height="20"
                                 viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                                <polyline points="10 17 15 12 10 7" />
                                <line x1="15" y1="12" x2="3" y2="12" />
                            </svg>
                            Entrar na sala
                        </button>

                        <button id="createRoomButton"
                                type="button"
                                class="btn btn-outline btn-primary w-full mt-3">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="20" height="20"
                                 viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="12" y1="8" x2="12" y2="16" />
                                <line x1="8" y1="12" x2="16" y2="12" />
                            </svg>
                            Criar sala
                        </button>
                    </div>
                </form>

                <footer class="text-center text-xs text-base-content/50">
                    Reúna seus amigos. Descubra os impostores.
                </footer>

            </div>
        </section>
    </main>
</div>

@section Scripts {
    <script src="~/js/cidade-dorme.js" asp-append-version="true"></script>
}
